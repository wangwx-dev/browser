{
  "schemaVersion": "1.0.0",
  "artifact": "ui-design",
  "mode": "hifi",
  "feature": "个人开发工作台重构",
  "updatedAt": "2026-07-24T00:00:00+08:00",
  "designDirection": {
    "name": "深色效率工作台",
    "principles": [
      "一个入口统一查找网站、工具和命令",
      "实体表面为主，玻璃拟态仅用于顶栏与浮层",
      "数据状态始终可见，破坏性操作可确认或撤销",
      "键盘优先但不牺牲移动端触控",
      "直接复用现有 React、CSS、Lucide 与 dnd-kit"
    ]
  },
  "tokens": {
    "colors": {
      "background": "#07111F",
      "sidebar": "#091525",
      "surface": "#0F1B2D",
      "surfaceRaised": "#16243A",
      "surfaceHover": "#1D2E47",
      "border": "#334155",
      "borderSubtle": "#22314A",
      "text": "#F8FAFC",
      "textSecondary": "#CBD5E1",
      "textMuted": "#94A3B8",
      "primary": "#0369A1",
      "primaryHover": "#075985",
      "primaryActive": "#0C4A6E",
      "accent": "#38BDF8",
      "link": "#7DD3FC",
      "success": "#4ADE80",
      "warning": "#FBBF24",
      "error": "#F87171",
      "info": "#60A5FA",
      "overlay": "rgba(2, 6, 23, 0.72)",
      "glass": "rgba(15, 27, 45, 0.88)",
      "white": "#FFFFFF"
    },
    "typography": {
      "fontSans": "Inter, -apple-system, BlinkMacSystemFont, Segoe UI, PingFang SC, Microsoft YaHei, sans-serif",
      "fontMono": "SFMono-Regular, Cascadia Code, Consolas, monospace",
      "display": {
        "fontSize": "32px",
        "lineHeight": "40px",
        "fontWeight": 700,
        "mobileFontSize": "28px",
        "mobileLineHeight": "36px"
      },
      "h1": {
        "fontSize": "28px",
        "lineHeight": "36px",
        "fontWeight": 700,
        "mobileFontSize": "24px",
        "mobileLineHeight": "32px"
      },
      "h2": {
        "fontSize": "20px",
        "lineHeight": "28px",
        "fontWeight": 650
      },
      "h3": {
        "fontSize": "16px",
        "lineHeight": "24px",
        "fontWeight": 600
      },
      "body": {
        "fontSize": "16px",
        "lineHeight": "24px",
        "fontWeight": 400
      },
      "small": {
        "fontSize": "14px",
        "lineHeight": "20px",
        "fontWeight": 400
      },
      "caption": {
        "fontSize": "12px",
        "lineHeight": "16px",
        "fontWeight": 500
      },
      "code": {
        "fontSize": "14px",
        "lineHeight": "22px",
        "fontWeight": 400
      }
    },
    "spacing": {
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "5": "20px",
      "6": "24px",
      "8": "32px",
      "10": "40px",
      "12": "48px",
      "16": "64px"
    },
    "radius": {
      "sm": "6px",
      "md": "10px",
      "lg": "14px",
      "xl": "18px",
      "full": "9999px"
    },
    "sizes": {
      "controlSmall": "36px",
      "controlDefault": "44px",
      "controlLarge": "52px",
      "desktopSidebarExpanded": "248px",
      "desktopSidebarCollapsed": "72px",
      "desktopTopbar": "64px",
      "mobileTopbar": "56px",
      "mobileBottomNav": "64px",
      "contentMax": "1440px"
    },
    "effects": {
      "cardShadow": "0 8px 24px rgba(0, 0, 0, 0.16)",
      "floatShadow": "0 16px 48px rgba(0, 0, 0, 0.36)",
      "focusRing": "0 0 0 2px #07111F, 0 0 0 4px #38BDF8",
      "glassBackdrop": "blur(16px)",
      "glassFallback": "#0F1B2D"
    },
    "motion": {
      "fast": "150ms cubic-bezier(0, 0, 0.2, 1)",
      "normal": "220ms cubic-bezier(0.4, 0, 0.2, 1)",
      "slow": "300ms cubic-bezier(0, 0, 0.2, 1)",
      "reducedMotion": {
        "duration": "1ms",
        "disable": [
          "transform",
          "smooth-scroll",
          "shimmer",
          "decorative-spin"
        ]
      }
    },
    "breakpoints": {
      "mobile": {
        "min": 0,
        "max": 768,
        "referenceWidth": 360
      },
      "medium": {
        "min": 769,
        "max": 1279,
        "referenceWidth": 1024
      },
      "desktop": {
        "min": 1280,
        "max": null,
        "referenceWidth": 1280
      }
    }
  },
  "pages": [
    {
      "id": "login",
      "name": "登录",
      "route": "/login",
      "viewport": {
        "width": 1280,
        "height": 800
      },
      "responsiveVariants": {
        "360": "表单满宽，左右20px，无悬浮阴影，主按钮52px",
        "768": "居中400px表单卡",
        "1280": "居中400px表单卡，品牌标识位于左上"
      },
      "frames": [
        {
          "id": "login-page",
          "type": "page",
          "name": "鉴权入口",
          "layout": "center",
          "style": {
            "background": "{colors.background}",
            "minHeight": "100dvh",
            "padding": "{spacing.5}"
          },
          "children": [
            {
              "id": "login-brand",
              "type": "brand",
              "content": "Dev Workbench",
              "icon": "TerminalSquare",
              "position": "top-left"
            },
            {
              "id": "auth-card",
              "type": "component",
              "componentId": "auth-card",
              "width": "min(400px, 100%)",
              "childrenOrder": [
                "title",
                "description",
                "page-alert",
                "email-field",
                "password-field",
                "submit",
                "mode-switch"
              ]
            }
          ]
        }
      ],
      "states": [
        {
          "id": "auth-loading",
          "trigger": "会话校验中",
          "presentation": "显示与登录卡同构的静态骨架",
          "accessibility": "容器 aria-busy=true，状态文字为正在检查登录状态"
        },
        {
          "id": "login-default",
          "trigger": "未登录",
          "presentation": "邮箱和密码字段、登录主按钮、创建账号次入口"
        },
        {
          "id": "login-submitting",
          "trigger": "提交有效表单",
          "presentation": "按钮 Spinner 加正在登录，保留输入并禁用重复提交"
        },
        {
          "id": "login-error",
          "trigger": "凭据或网络失败",
          "presentation": "字段级错误加 role=alert 摘要，聚焦首个错误",
          "recovery": "修正字段后重试"
        },
        {
          "id": "session-expired",
          "trigger": "工作台会话失效",
          "presentation": "提示登录状态已过期，说明未同步内容仍保留在设备",
          "recovery": "重新登录并返回安全站内目标"
        }
      ]
    },
    {
      "id": "home",
      "name": "统一工作台首页",
      "route": "/",
      "viewport": {
        "width": 1280,
        "height": 960
      },
      "responsiveVariants": {
        "360": "56px顶栏、5项底部导航、16px边距、所有模块单列、收藏2列",
        "768": "移动壳、24px边距、收藏4列、卡片2列",
        "1280": "248px或72px侧栏、64px顶栏、32px边距、内容最大1440px"
      },
      "frames": [
        {
          "id": "home-app-shell",
          "type": "page",
          "name": "工作台应用壳",
          "layout": "app-shell",
          "children": [
            {
              "id": "desktop-sidebar-instance",
              "type": "component",
              "componentId": "desktop-sidebar",
              "visibleWhen": "viewport >= 769px"
            },
            {
              "id": "mobile-nav-instance",
              "type": "component",
              "componentId": "mobile-navigation",
              "visibleWhen": "viewport <= 768px"
            },
            {
              "id": "home-topbar",
              "type": "component",
              "componentId": "topbar",
              "content": [
                "页面标题",
                "命令入口",
                "同步状态",
                "账户菜单"
              ]
            },
            {
              "id": "home-main",
              "type": "main",
              "layout": "vertical",
              "gap": "{spacing.8}",
              "children": [
                {
                  "id": "greeting",
                  "type": "hero",
                  "title": "早上好/下午好/晚上好，{用户名}",
                  "subtitle": "从一个入口继续今天的开发工作"
                },
                {
                  "id": "unified-search",
                  "type": "component",
                  "componentId": "command-entry",
                  "height": "{sizes.controlLarge}",
                  "placeholder": "搜索网站、工具或命令…"
                },
                {
                  "id": "favorites-section",
                  "type": "section",
                  "title": "收藏",
                  "maxItems": 8,
                  "componentId": "resource-card",
                  "layout": "responsive-grid"
                },
                {
                  "id": "recent-section",
                  "type": "section",
                  "title": "最近使用",
                  "maxItems": 10,
                  "componentId": "resource-card",
                  "variant": "compact-list"
                },
                {
                  "id": "frequent-tools-section",
                  "type": "section",
                  "title": "常用工具",
                  "maxItems": 6,
                  "componentId": "resource-card",
                  "variant": "tool-grid"
                },
                {
                  "id": "navigation-groups-section",
                  "type": "section",
                  "title": "网站导航",
                  "action": "管理导航",
                  "layout": "grouped-resource-grid"
                }
              ]
            }
          ]
        }
      ],
      "states": [
        {
          "id": "home-loading",
          "trigger": "首次加载个人数据",
          "presentation": "问候、搜索、收藏和列表同构骨架",
          "timeout": "10s 后显示加载时间较长及重试"
        },
        {
          "id": "home-ready",
          "trigger": "数据加载成功",
          "presentation": "按问候、搜索、收藏、最近、常用工具、导航分组显示"
        },
        {
          "id": "home-empty-favorites",
          "trigger": "没有收藏",
          "presentation": "Star 图标、把常用网站或工具固定到这里、浏览工具按钮"
        },
        {
          "id": "home-empty-recent",
          "trigger": "没有最近使用",
          "presentation": "Clock3 图标、打开过的内容会出现在这里、开始搜索按钮"
        },
        {
          "id": "home-offline-cache",
          "trigger": "读取失败但存在缓存",
          "presentation": "展示缓存内容并置顶离线横幅",
          "recovery": "继续本地使用，网络恢复自动重试"
        },
        {
          "id": "home-load-error",
          "trigger": "读取失败且无缓存",
          "presentation": "错误状态页，不显示空导航",
          "recovery": "重试或重新登录"
        }
      ]
    },
    {
      "id": "command-palette",
      "name": "全局命令面板",
      "route": "overlay://command-palette",
      "viewport": {
        "width": 1280,
        "height": 800
      },
      "responsiveVariants": {
        "360": "100dvh全屏，无圆角，查询区和关闭按钮固定，结果独立滚动",
        "768": "100dvh全屏",
        "1280": "顶部12vh，宽680px，最大高70vh，居中浮层"
      },
      "frames": [
        {
          "id": "command-dialog",
          "type": "dialog",
          "name": "搜索网站、工具或命令",
          "componentId": "command-palette",
          "style": {
            "background": "{colors.glass}",
            "fallbackBackground": "{colors.surface}",
            "border": "1px solid {colors.border}",
            "radius": "{radius.xl}",
            "shadow": "{effects.floatShadow}"
          },
          "children": [
            {
              "id": "command-query",
              "type": "combobox",
              "placeholder": "搜索网站、工具或命令…",
              "height": "56px"
            },
            {
              "id": "command-results",
              "type": "listbox",
              "itemComponentId": "command-result-row",
              "itemHeight": "48px"
            },
            {
              "id": "command-help",
              "type": "footer",
              "visibleWhen": "viewport >= 769px",
              "content": "↑↓ 选择 · Enter 打开 · Esc 关闭"
            }
          ]
        }
      ],
      "states": [
        {
          "id": "command-empty-query",
          "trigger": "查询为空",
          "presentation": "依次显示收藏、最近使用、常用工具"
        },
        {
          "id": "command-searching",
          "trigger": "查询处理超过150ms",
          "presentation": "查询框右侧显示16px Spinner，保持活动资源ID"
        },
        {
          "id": "command-results-ready",
          "trigger": "有匹配结果",
          "presentation": "统一列表，以网站或工具标签区分"
        },
        {
          "id": "command-no-results",
          "trigger": "无匹配",
          "presentation": "没有找到匹配项，提供清除搜索和新增网站",
          "privacy": "不得发起外部搜索"
        }
      ]
    },
    {
      "id": "navigation",
      "name": "我的导航",
      "route": "/navigation",
      "viewport": {
        "width": 1280,
        "height": 960
      },
      "responsiveVariants": {
        "360": "单列网站列表，操作进入菜单，排序用移至/上移/下移",
        "768": "单列或2列，自定义Dialog全屏或底部Sheet，不依赖触摸拖拽",
        "1280": "分类描边Section，网站响应式卡片网格，指针与键盘拖拽"
      },
      "frames": [
        {
          "id": "navigation-page",
          "type": "page",
          "layout": "app-shell",
          "children": [
            {
              "id": "navigation-header",
              "type": "page-header",
              "title": "我的导航",
              "children": [
                "同步状态",
                "筛选",
                "编辑布局",
                "新增网站"
              ]
            },
            {
              "id": "navigation-categories",
              "type": "sortable-sections",
              "componentId": "navigation-category",
              "itemComponentId": "resource-card"
            },
            {
              "id": "navigation-editor-dialog",
              "type": "dialog",
              "componentId": "navigation-editor",
              "visibleWhen": "create-or-edit"
            },
            {
              "id": "navigation-delete-dialog",
              "type": "dialog",
              "componentId": "confirmation-dialog",
              "visibleWhen": "delete-requested"
            }
          ]
        }
      ],
      "states": [
        {
          "id": "navigation-loading",
          "trigger": "首次读取",
          "presentation": "分类标题和网站卡同构骨架"
        },
        {
          "id": "navigation-ready",
          "trigger": "默认浏览",
          "presentation": "分类与网站可打开、收藏和进入更多菜单"
        },
        {
          "id": "navigation-editing",
          "trigger": "进入编辑布局",
          "presentation": "显示拖拽手柄、新增分类、编辑和删除动作",
          "keyboard": "Space抓取或放下，方向键移动，Esc取消"
        },
        {
          "id": "navigation-filtered",
          "trigger": "筛选词非空",
          "presentation": "只显示匹配分类和网站，拖拽禁用并解释原因"
        },
        {
          "id": "navigation-empty",
          "trigger": "没有任何导航数据",
          "presentation": "FolderPlus 图标、建立第一个分类、创建分类按钮"
        },
        {
          "id": "navigation-no-results",
          "trigger": "筛选无结果",
          "presentation": "没有匹配的网站，提供清除筛选和新增网站"
        },
        {
          "id": "navigation-pending-sync",
          "trigger": "任意本地变更",
          "presentation": "100ms内乐观更新并显示待同步"
        },
        {
          "id": "navigation-offline",
          "trigger": "网络不可用",
          "presentation": "离线横幅，修改已保存在本机",
          "recovery": "恢复网络后自动重试，也可查看队列"
        },
        {
          "id": "navigation-sync-failed",
          "trigger": "提交失败",
          "presentation": "同步失败状态和重试按钮，不回滚本地数据"
        },
        {
          "id": "navigation-conflict",
          "trigger": "本地待同步与云端冲突",
          "presentation": "对话框并列显示本地与云端更新时间",
          "actions": [
            "保留本地",
            "使用云端",
            "稍后处理"
          ]
        },
        {
          "id": "navigation-undo",
          "trigger": "删除或移动完成",
          "presentation": "7秒Undo Toast，含撤销按钮",
          "dataBehavior": "撤销进入同一持久化同步队列"
        }
      ]
    },
    {
